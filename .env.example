# PayPal sandbox credentials — free at https://developer.paypal.com/
# Use a SANDBOX account, never your real PayPal login.
# Copy this file to .env and fill in your own values. Never commit .env.
PAYPAL_CLIENT_ID=your-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-sandbox-client-secret
PAYPAL_MODE=sandbox

# Port for the demo dashboard (npm run serve)
PORT=3000
